      "require": "./dist/index.cjs"
    },
    "./core": {
      "import": "./src/core/index.js"
    },
    "./util": {
      "import": "./src/util/index.js"
    },
    "./compare": {
      "import": "./src/util/compare.js"
    },
    "./filter": {
      "import": "./src/util/filter.js"
    },
    "./sort": {
      "import": "./src/util/sort.js"
    }
  },
  "unpkg": "./dist/index.js",
