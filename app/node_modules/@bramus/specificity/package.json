  "devDependencies": {
    "benchmark": "^2.1.4",
    "esbuild": "^0.25.0",
    "microtime": "^3.1.1",
    "mocha": "^11.1.0",
    "prettier": "^3.5.1",
    "semver": "^7.7.1"
  },
  "dependencies": {
    "css-tree": "^3.0.0"
