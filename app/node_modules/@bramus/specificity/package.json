{
  "name": "@bramus/specificity",
  "version": "2.4.2",
  "description": "Calculate specificity of a CSS Selector",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "browser": "./dist/index.js",
