{
  "name": "@aiden0z/pptx-renderer",
  "version": "1.2.4",
  "packageManager": "pnpm@9.15.9",
  "description": "Parse and render PPTX files in the browser with a TypeScript-first engine.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/aiden0z/pptx-renderer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiden0z/pptx-renderer.git"
  },
  "type": "module",
  "main": "./dist/aiden0z-pptx-renderer.cjs",
  "module": "./dist/aiden0z-pptx-renderer.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/aiden0z-pptx-renderer.es.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/aiden0z-pptx-renderer.cjs"
      }
    },
    "./browser": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/aiden0z-pptx-renderer.browser.es.js",
      "default": "./dist/aiden0z-pptx-renderer.browser.es.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/renderer/chart/echartsRuntime.ts",
    "./dist/aiden0z-pptx-renderer.es.js",
    "./dist/aiden0z-pptx-renderer.cjs",
    "./dist/aiden0z-pptx-renderer.browser.es.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "size-limit": [
    {
      "path": "dist/aiden0z-pptx-renderer.es.js",
      "limit": "1400 kB",
      "gzip": true
    },
    {
      "path": "dist/aiden0z-pptx-renderer.browser.es.js",
      "limit": "500 kB",
      "gzip": true
    }
  ],
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "echarts": "^6.0.0",
    "jszip": "^3.10.1"
  },
  "peerDependencies": {
    "pdfjs-dist": ">=5 <7"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@size-limit/file": "^12.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "canvas": "^3.2.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "knip": "^5.85.0",
    "lint-staged": "^16.2.7",
    "pdfjs-dist": "^5.4.624",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "publint": "^0.3.17",
    "size-limit": "^12.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}