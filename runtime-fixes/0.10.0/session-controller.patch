+/** Stream authorized media in bounded chunks so video seeking does not load the whole file. */
+async function serveMediaStream(request, fs) {
+	const fail = (status, text, headers = {}) => new Response(request.method === "HEAD" ? null : text, {
+		status,
+		headers: { ...BASE_HEADERS, ...headers }
+	});
+	const path = new URL(request.url).searchParams.get("path");
+	if (!path || path.includes("\0") || !isAbsolute(path)) return fail(400, "absolute path required");
+	try {
+		const target = await fs.resolve(path, { signal: request.signal });
+		const info = await fs.stat(target, request.signal);
+		if (info === void 0) return fail(404, "not found");
+		if (info.type !== "file") return fail(403, "not a regular file");
+		const size = info.size;
+		if (!Number.isSafeInteger(size) || size < 0) return fail(500, "invalid file size");
+		const range = request.headers.get("range");
+		let start = 0;
+		let end = size - 1;
+		if (range) {
+			const match = /^bytes=(\d*)-(\d*)$/.exec(range);
+			if (!match || match[1] === "" && match[2] === "") return fail(416, "invalid range", { "Content-Range": `bytes */${size}` });
+			if (match[1] === "") {
+				const suffix = Number(match[2]);
+				if (!Number.isSafeInteger(suffix) || suffix < 1 || size === 0) return fail(416, "invalid range", { "Content-Range": `bytes */${size}` });
+				start = Math.max(0, size - suffix);
+			} else {
+				start = Number(match[1]);
+				if (match[2] !== "") end = Math.min(Number(match[2]), size - 1);
+			}
+			if (!Number.isSafeInteger(start) || !Number.isSafeInteger(end) || start >= size || end < start) return fail(416, "invalid range", { "Content-Range": `bytes */${size}` });
+		}
+		const headers = {
+			...BASE_HEADERS,
+			"Content-Type": mime.lookup(target.displayPath) || "application/octet-stream",
+			"Accept-Ranges": "bytes",
+			"Content-Length": String(end - start + 1),
+			...(range ? { "Content-Range": `bytes ${start}-${end}/${size}` } : {})
+		};
+		if (request.method === "HEAD" || size === 0) return new Response(null, { status: range ? 206 : 200, headers });
+		let offset = start;
+		const stream = new ReadableStream({
+			async pull(controller) {
+				try {
+					const length = Math.min(1024 * 1024, end - offset + 1);
+					const bytes = await fs.readByteRange(target, { offset, length }, request.signal);
+					if (bytes.byteLength !== length) throw new Error("media changed during read");
+					controller.enqueue(bytes);
+					offset += length;
+					if (offset > end) controller.close();
+				} catch (error) { controller.error(error); }
+			}
+		});
+		return new Response(stream, { status: range ? 206 : 200, headers });
+	} catch (error) {
+		if (!(error instanceof FsError)) throw error;
+		return fail({
+			FS_NOT_FOUND: 404,
+			FS_NOT_REGULAR_FILE: 403,
+			FS_PERMISSION_DENIED: 403,
+			FS_SANDBOX_DENIED: 403,
+			FS_ABORTED: 499
+		}[error.code] ?? 500, error.code);
+	}
+}
